# Rime (TTS provider) — get key at https://rime.ai (dashboard: https://app.rime.ai/tokens)
# Pinned by scripts/smoke_test.py: model "coda", Hindi voice "nadi", English voice "astra"
RIME_API_KEY=your_rime_api_key
RIME_API_BASE=https://users.rime.ai/v1
RIME_MODEL=coda
RIME_SPEAKER=nadi
RIME_SPEAKER_HIN=nadi
RIME_SPEAKER_ENG=astra
# language codes, corrected by scripts/smoke_test.py if needed
RIME_LANG_HIN=hin
RIME_LANG_ENG=eng
# audio format Rime returns / we request
RIME_OUTPUT_FORMAT=wav

# Groq (segmenter router LLM) — get key at https://console.groq.com
# mixtral-8x7b-32768 is deprecated (shutdown Mar 2025); llama-3.1-8b-instant
# followed (shutdown Aug 2026). Lock current IDs via the Groq models API.
GROQ_API_KEY=your_groq_api_key
GROQ_ROUTER_MODEL=openai/gpt-oss-20b
GROQ_SECOND_MODEL=openai/gpt-oss-120b

# OpenRouter (bonus experiment only — everything works without this)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-r1:free
